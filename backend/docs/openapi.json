{
  "openapi": "3.0.3",
  "info": {
    "title": "Starlight Game Backend",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8082"
    }
  ],
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "game_id": {
            "type": "string"
          },
          "game_name": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "interval_minutes": {
            "type": "integer"
          },
          "offset_minutes": {
            "type": "integer"
          },
          "group": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "format": {
            "type": "string",
            "enum": [
              "digits",
              "triple",
              "padded",
              "marksix",
              "sum"
            ]
          },
          "rule": {
            "type": "string"
          }
        }
      },
      "Round": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "source_issue": {
            "type": "string"
          },
          "source_group": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "display_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sum": {
            "type": "integer"
          },
          "draw_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "origin": {
            "type": "string",
            "enum": [
              "simulated_history",
              "scheduled"
            ]
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "latest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Round"
              }
            ],
            "nullable": true
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "expected_issue": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          },
          "next_draw_at": {
            "type": "string",
            "format": "date-time",
            "description": "下一期业务开奖时间：对应分钟第05秒；05秒前保持本期期号"
          },
          "bet_close_at": {
            "type": "string",
            "format": "date-time",
            "description": "本期封盘时间：开奖分钟之前10秒，比next_draw_at早15秒"
          },
          "betting_open": {
            "type": "boolean",
            "description": "当前是否在允许下注时段；其他权限与场次开关另行校验"
          }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Round"
            }
          },
          "total": {
            "type": "integer"
          },
          "next_before": {
            "type": "string"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/games": {
      "get": {
        "summary": "全部游戏场次",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Catalog"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "场次或期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/state": {
      "get": {
        "summary": "开奖状态及北京时间倒计时",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ssc-10",
                "ffc-1",
                "ffc-3",
                "ffc-5",
                "k3-1",
                "k3-3",
                "k3-5",
                "pk10-10",
                "lhc-daily",
                "pc28-5"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/State"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "场次或期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/draws": {
      "get": {
        "summary": "历史开奖记录",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ssc-10",
                "ffc-1",
                "ffc-3",
                "ffc-5",
                "k3-1",
                "k3-3",
                "k3-5",
                "pk10-10",
                "lhc-daily",
                "pc28-5"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "排除此期的倒序游标"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/History"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "场次或期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session}/draws/{issue}": {
      "get": {
        "summary": "精确查询期号",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ssc-10",
                "ffc-1",
                "ffc-3",
                "ffc-5",
                "k3-1",
                "k3-3",
                "k3-5",
                "pk10-10",
                "lhc-daily",
                "pc28-5"
              ]
            }
          },
          {
            "name": "issue",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Round"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "场次或期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
