{
  "openapi": "3.0.3",
  "info": {
    "title": "Starlight Number API",
    "version": "4.0.0",
    "description": "北京时间每天00:00预生成当天1440批g1–g8，后端按开奖期号提取。所有号码API要求Bearer密钥；latest为最后已保存批次，可能未开奖。schema_version=4支持提前生成，兼容旧版1/2/3。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/groups": {
      "get": {
        "summary": "读取七组规则",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚无首期数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/draws/latest": {
      "get": {
        "summary": "读取最近一期，调用方需核对是否过期",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Draw"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚无首期数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "最后已保存的批次，通常当天23:59，不能当作最近已开奖期。"
      }
    },
    "/api/v1/draws/{issue}": {
      "get": {
        "summary": "读取指定期号",
        "parameters": [
          {
            "name": "issue",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "北京时间 YYYYMMDDHHmm，或 latest"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Draw"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚无首期数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/draws": {
      "get": {
        "summary": "历史倒序分页",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": ""
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "排除此期的倒序游标"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Page"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚无首期数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/draws/{issue}/groups/{group}": {
      "get": {
        "summary": "整组或固定位置取号",
        "parameters": [
          {
            "name": "issue",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "北京时间 YYYYMMDDHHmm，或 latest"
          },
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "g1",
                "g2",
                "g3",
                "g4",
                "g5",
                "g6",
                "g7",
                "g8"
              ]
            },
            "description": ""
          },
          {
            "name": "positions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1,3,5"
            },
            "description": "从1开始，不可重复。g4最大9、g7最大49，其他最大10。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Selection"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "无效参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "期号不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "尚无首期数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "存储错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "进程存活",
        "security": [],
        "responses": {
          "200": {
            "description": "进程存活"
          },
          "503": {
            "description": "尚无新鲜结果"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "有新鲜结果才就绪",
        "security": [],
        "responses": {
          "200": {
            "description": "有新鲜结果才就绪"
          },
          "503": {
            "description": "尚无新鲜结果"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Draw": {
        "type": "object",
        "required": [
          "schema_version",
          "issue",
          "timezone",
          "scheduled_at",
          "generated_at",
          "groups"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "issue": {
            "type": "string",
            "pattern": "^[0-9]{12}$"
          },
          "timezone": {
            "type": "string",
            "enum": [
              "Asia/Shanghai"
            ]
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "逻辑批次时间，为兼容旧协议保留分钟第01秒；业务05秒公布。"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "实际生成时间；v4通常为当天00:00，早于逻辑批次时间。"
          },
          "groups": {
            "type": "object",
            "required": [
              "g1",
              "g2",
              "g3",
              "g4",
              "g5",
              "g6"
            ],
            "properties": {
              "g1": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                }
              },
              "g2": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                }
              },
              "g3": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                }
              },
              "g4": {
                "type": "array",
                "minItems": 9,
                "maxItems": 9,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                }
              },
              "g5": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "g6": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "g7": {
                "type": "array",
                "minItems": 49,
                "maxItems": 49,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 49
                }
              },
              "g8": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "uniqueItems": false,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              }
            }
          },
          "display_groups": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "展示字符串：g6为01–10；g7为01–49"
          }
        }
      },
      "Selection": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "g1",
              "g2",
              "g3",
              "g4",
              "g5",
              "g6",
              "g7",
              "g8"
            ]
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "逻辑批次时间，为兼容旧协议保留分钟第01秒；业务05秒公布。"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "实际生成时间；v4通常为当天00:00，早于逻辑批次时间。"
          },
          "display_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Draw"
            }
          },
          "next_before": {
            "type": "string"
          }
        }
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer",
            "enum": [
              86400
            ]
          },
          "trigger_second": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "position_base": {
            "type": "integer"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "min": {
                  "type": "integer"
                },
                "max": {
                  "type": "integer"
                },
                "count": {
                  "type": "integer"
                },
                "allow_repeat": {
                  "type": "boolean"
                }
              }
            }
          },
          "generation_mode": {
            "type": "string",
            "enum": [
              "daily_pre_generated"
            ]
          },
          "batches_per_day": {
            "type": "integer",
            "enum": [
              1440
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
